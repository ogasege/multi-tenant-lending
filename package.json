{
  "name": "tenmg-lending-core",
  "version": "0.1.0",
  "description": "Multi-tenant white-label lending backend (10MG V2 reference implementation)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "db:migrate": "scripts/db-migrate.sh",
    "platform:create-admin": "node dist/modules/platform/cli/create-platform-admin.js",
    "seed": "nest build && node dist/cli/seed.js",
    "openapi:export": "nest build && node dist/cli/openapi-export.js",
    "openapi:check": "nest build && node dist/cli/openapi-export.js --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run --project db",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1163.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-sqs": "3.1163.0",
    "@aws-sdk/lib-dynamodb": "3.1163.0",
    "@aws-sdk/s3-presigned-post": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@date-fns/utc": "2.1.1",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "argon2": "0.45.2",
    "canonicalize": "5.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "kysely": "0.29.8",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@testcontainers/localstack": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
