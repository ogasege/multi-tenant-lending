# Keep the build context small and free of secrets and local state.
# Allow-list thinking: anything not needed to build or test the app stays out.

# VCS, tooling and editor state: every dot-file and dot-folder at the context root
# (none is needed to build or test the app)
.*
**/.DS_Store

# Dependencies and build output are produced inside the image
node_modules
dist
coverage
.vitest
*.tsbuildinfo

# Secrets and local environment (never baked into an image)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets

# Not part of the application image
docs
infra
docker
docker-compose*.yml
compose*.yml
Makefile
Dockerfile
.dockerignore
# Local reference images at the build-context root
/*.png
*.log
.localstack
volume
