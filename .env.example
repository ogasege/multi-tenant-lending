# =============================================================================
# Local docker-compose environment. Copy to `.env` (`make up` does it for you).
#
#   !!! LOCAL ONLY !!!  Every secret below is a throwaway value generated for
#   this example file. Never reuse any of them in a shared or cloud
#   environment: there, secrets come from AWS Secrets Manager at deploy time.
#
# Variable names follow the runtime contract in docs/design/SPEC.md §12.
# docker-compose reads this file for ${VAR} interpolation and hands each
# service ONLY the variables it needs (least privilege: the API never sees
# the migrator or worker passwords).
# =============================================================================

# --- Host ports (change if they clash with something already running) -------
API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
LOCALSTACK_HOST_PORT=4566

# --- Application -------------------------------------------------------------
# NODE_ENV for the app containers. Default `test`: JSON logs, Swagger UI at
# http://localhost:3000/docs, and plain-http cell URLs allowed (production
# demands https:// CELL_API_BASE_URL). Not `development`: that loads
# pino-pretty, which the runtime image does not contain.
APP_NODE_ENV=test
LOG_LEVEL=info
JWT_ISSUER=tenmg-lending-local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# LOCAL ONLY: >= 32 chars (256-bit random, hex encoded).
JWT_SECRET=local-only-a2dfd9cd30c0939a4c287145e740029d8e64dcd1a7c93a29ca1edd1f4fb89345
BVN_HMAC_KEY=local-only-7d851081d9f8b4fa8d1cabb018d669c45314532513087f06767ff59b32c13307
# LOCAL ONLY: base64 of exactly 32 random bytes (AES-256-GCM key).
# Generate a fresh one with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=KxYDvv0jXoo/um4MPAcodSDapq4+tffmMbI0JnYv+YI=

# --- PostgreSQL --------------------------------------------------------------
DATABASE_NAME=lending
# LOCAL ONLY: container superuser; used solely by the one-time init script.
POSTGRES_SUPERUSER_PASSWORD=local-only-bdbae300c53c66c63a5f8a00
# Schema owner (non-superuser, CREATEROLE), like the RDS master user.
# Used ONLY by the migrate service.
DATABASE_MIGRATOR_USER=lending_owner
DATABASE_MIGRATOR_PASSWORD=local-only-79c0ac3f84f4a8d5f0cacfbd
# Runtime login roles; created/rotated by the migrate service.
DATABASE_APP_USER=lending_app
DATABASE_APP_PASSWORD=local-only-800f22fa9e476b1577976ca7
DATABASE_WORKER_USER=lending_worker
DATABASE_WORKER_PASSWORD=local-only-eb9f829152b15b9b933d409b
DATABASE_POOL_MAX=10

# --- Redis -------------------------------------------------------------------
# LOCAL ONLY. AUTH is on locally too, mirroring ElastiCache.
REDIS_PASSWORD=local-only-0ec26bb492202c18e3254670

# --- AWS (LocalStack) --------------------------------------------------------
# af-south-1 per ADR-001; LocalStack accepts any region.
AWS_REGION=af-south-1
# Resource names match infra/terraform/environments/local (prefix lending-local).
S3_BRANDING_BUCKET=lending-local-branding
SQS_DOMAIN_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/lending-local-domain-events
# Presigned S3 URLs handed to browsers (logo GET, upload POST) are signed for
# this host; server-side S3 calls keep using http://localstack:4566. Leave
# unset in AWS (the regional S3 endpoint is public; production requires https).
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# Global tenant directory (DynamoDB table created by the LocalStack init hook).
DIRECTORY_TABLE_NAME=lending-local-tenant-directory

# --- Cells -------------------------------------------------------------------
# Primary cell (service `api`).
CELL_REGION=af-south-1
CELL_API_BASE_URL=http://localhost:3000
# Trusted cells (JSON region -> origin), shared by every cell. Redirects go
# only to these origins.
CELL_ORIGINS='{"af-south-1":"http://localhost:3000","eu-west-3":"http://localhost:3001"}'
# Second cell for the `two-cells` profile / `make demo-cells` (service api-eu).
EU_CELL_REGION=eu-west-3
EU_CELL_API_BASE_URL=http://localhost:3001
EU_API_HOST_PORT=3001
EU_DATABASE_NAME=lending_eu

# --- Worker ------------------------------------------------------------------
# Tuning variables (OUTBOX_*, SQS_WAIT_TIME_SECONDS, WEBHOOK_*,
# DIRECTORY_RECONCILE_INTERVAL_MINUTES, EOD_*, DATABASE_WORKER_POOL_MAX) all
# have defaults in src/config/worker-env.schema.ts; set them here only to
# override.

# --- Demo seed (`make seed`, `make seed-all`) ---------------------------------
# LOCAL ONLY demo credentials. Leave a password empty to have the seed
# generate a random one and print it.
SEED_PLATFORM_ADMIN_EMAIL=ops@platform.example
SEED_PLATFORM_ADMIN_PASSWORD=Local-Only-Admin-7c41e9
SEED_STAFF_PASSWORD=Local-Only-Staff-3b8d20
SEED_CUSTOMER_PASSWORD=Local-Only-Customer-91fa6e

# Optional: LocalStack auth token. Not needed for the pinned 4.14.0 image.
LOCALSTACK_AUTH_TOKEN=
